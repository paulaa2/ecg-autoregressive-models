    "print(f\"  Entropía ArrF:   {entropy_arrF:.4f} bits\")\n",
    "print(f\"  Diferencia:      {abs(entropy_normal - entropy_arrF):.4f} bits\")\n",
    "\n",
    "if entropy_arrF < entropy_normal:\n",
